# ─────────────────────────────────────────────────────────────────────────────
# Trading Application — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Trading Mode ─────────────────────────────────────────────────────────────
# Set to false only when you are ready to trade with real money.
PAPER_TRADING=true

# ─── Capital ──────────────────────────────────────────────────────────────────
INITIAL_CAPITAL_GBP=100

# ─── Kraken (Primary crypto broker — FCA registered, UK compliant) ────────────
# Create API keys at: kraken.com → Security → API
# Permissions needed: Query Funds, Query Open Orders, Create & Modify Orders
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# ─── Coinbase Advanced Trade (Backup crypto broker) ───────────────────────────
# Create at: coinbase.com → Settings → API
COINBASE_API_KEY=
COINBASE_PRIVATE_KEY=

# ─── Interactive Brokers (TWS / IB Gateway) ───────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ─── Market Data ──────────────────────────────────────────────────────────────
POLYGON_API_KEY=
NEWS_API_KEY=

# ─── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_in_production
TIMESCALEDB_URL=postgresql+asyncpg://trader:${DB_PASSWORD}@localhost:5432/trading

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Risk Management ──────────────────────────────────────────────────────────
# Maximum fraction of equity that can be lost in a single trading day.
MAX_DAILY_LOSS_PCT=0.20
# Maximum peak-to-trough drawdown before all positions are closed.
MAX_DRAWDOWN_PCT=0.35
# Maximum fraction of equity allocated to any single position.
MAX_POSITION_SIZE_PCT=0.25

# ─── Growth Phases ────────────────────────────────────────────────────────────
# Phase 1 ends when equity reaches this target (GBP).
PHASE1_TARGET_GBP=10000
# Phase 2 ends when equity reaches this target (GBP).
PHASE2_TARGET_GBP=1000000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
